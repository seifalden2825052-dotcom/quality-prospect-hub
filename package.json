{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "bash ./scripts/build-hostinger.sh",
    "start": "corepack pnpm --filter @workspace/api-server run start",
    "hostinger:install": "bash ./scripts/hostinger-install.sh",
    "db:push": "corepack pnpm --filter @workspace/db run push",
    "data:export": "corepack pnpm --filter @workspace/scripts run export-data",
    "data:import": "corepack pnpm --filter @workspace/scripts run import-data",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@vercel/ncc": "0.38.4",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}