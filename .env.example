# Runtime
NODE_ENV=production
PORT=8080
BASE_PATH=/
LOG_LEVEL=info

# PostgreSQL — use any reachable PostgreSQL provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Admin login — set strong values in the hosting provider's secret manager
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Replit App Storage (required only when keeping uploads on Replit)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Hosting note:
# The current media-upload routes use Replit App Storage. For Hostinger/Vercel,
# replace that adapter with an S3-compatible bucket and provide its credentials
# through the hosting provider's environment-variable settings. Never commit
# real secrets or a populated .env file.